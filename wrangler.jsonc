{
  "name": "private-http-test",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",

  "secrets_store_secrets": [
    {
      "binding": "API_ID",
      "store_id": "c40cc3dcc6234fb98cab408bd2f302be",
      "secret_name": "API_ID"
    },
    {
      "binding": "API_HASH",
      "store_id": "c40cc3dcc6234fb98cab408bd2f302be",
      "secret_name": "API_HASH"
    },
    {
      "binding": "MTKRUTO_SESSION",
      "store_id": "c40cc3dcc6234fb98cab408bd2f302be",
      "secret_name": "MTKRUTO_SESSION"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "MTKRUTO_CACHE",
      "id": "2fb2beb6903843dca8606cde0633311b"
    }
  ],

  "cache": {
      "enabled": true
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "TELEGRAM_DO",
        "class_name": "TelegramConnectionDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TelegramConnectionDO"]
    }
  ]
}
